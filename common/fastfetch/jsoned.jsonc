{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": ": "
  },
  "modules": [
    {
      "type": "custom",
      "format": "  {",
      "keyColor": "white"
    },
    {
      "type": "title",
      "format": "    \"{2}\": \u007b\u007B"
    },
    {
      "type": "os",
      "key": " ",
      "format": "        \"os\": \"{2}\",",
      "keyColor": "white"
    },
    {
      "type": "title",
      "format": "        \"current_user\": \"{1}\","
    },
    {
      "type": "custom",
      "format": "        \"packages\": {"
    },
    {
      "type": "packages",
      "key": " ",
      "format": "            \"all\": {1}, \n            \"pacman\": {pacman},\n            \"flatpak\": {flatpak-all}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "        },"
    },
    {
      "type": "shell",
      "key": " ",
      "format": "        \"shell\": \u007b\u007B\"name\": \"{2}\", \"version\": \"{4}\"},",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": " ",
      "format": "        \"window_manager\": \u007b\u007B\"name\": \"{1}\", \"on\": \"{3}\"},",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": " ",
      "format": "        \"uptime\": \u007b\u007B\"formatted\": \"{formatted}\", \"booted-at\": \"{boot-time}\"}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "    },"
    },
    {
      "type": "custom",
      "format": "    \"hardware\": {"
    },
    {
      "type": "cpu",
      "format": "        \"cpu\": \u007b\u007B\"name\": \"{1}\", \"phys_cores\": {3}, \"logic_cores\": {4}},",
      "key": " "
    },
    {
      "type": "gpu",
      "format": "        \"gpu\": \u007b\u007B\n            \"vendor\": \"{1}\", \n            \"model\": \"{name}\",\n            \"driver\": \"{driver}\"\n        },",
      "key": " "
    },
    {
      "type": "memory",
      "key": " ",
      "format": "        \"ram\": \u007b\u007B\"total\": \"{2}\", \"used\": \"{1} ({3})\"},"
    },
    {
      "type": "swap",
      "key": " ",
      "format": "        \"swap\": \u007b\u007B\"total\": \"{2}\", \"used\": \"{1} ({3})\"},"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "        \"storages\": \u007b\u007B"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "            \"phys_disks\": ["
    },
    {
      "type": "physicaldisk",
      "key": " ",
      "format": "                \u007b\u007B\"name\": \"{name}\", \"path\": \"{dev-path}\", \"size\": \"{1}\",\n                  \"type\": \"{6}\", \"interconnect\": \"{interconnect}\", \"revision\": \"{revision}\"},"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "            ],"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "            \"mounted_partitions\": ["
    },
    {
      "type": "disk",
      "key": " ",
      "format": "                \u007b\u007B\"name\":\"{name}\", \"mountpoint\": \"{mountpoint}\", \"fs\": \"{filesystem}\", \"mount-from\":\"{mount-from}\",\n                  \"total\": \"{size-total}\", \"used\": \"{size-used} ({size-percentage})\"},"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "            ],"
    },
    {
      "type": "custom",
      "key": " ",
      "format": "        },"
    },
    {
     "type": "board",
     "key": " ",
     "format": "        \"motherboard\": \u007b\u007B\"name\": \"{1}\", \"vendor\": \"{2}\"},"
    },
    {
      "type": "bios",
      "key": " ",
      "format": "        \"bios\": \u007b\u007B\"date\": \"{1}\", \"release\":\"{release}\", \"version\": \"{4}\", \"type\": \"{5}\"},"
    },
    {
      "type": "display",
      "key": " ",
      "format": "        \"display\": \u007b\u007B\"model\": \"{6}\", \"h_size\": {1}, \"v_size\": {2}, \"hz\": {3}}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "    }"
    },
    {
      "type": "custom",
      "format": "  }"
    }
  ]
}
