{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "height": 16,
    "width": 50,
    "padding": {
      "right": 5,
      "left": 5,
      "top": 2
    }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "color": {
      "keys": "reset_light_white"
    },
    "key": {
      "width": 10,
      "type": "string"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "> fastfetch of the {host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{all}"
    },
    {
      "type": "shell",
      "key": "sh"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{process-name} - {protocol-name}"
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": "ram",
      "format": "{total}"
    },
    {
      "type": "display",
      "key": "display",
      "format": "{width}x{height}@{refresh-rate} {inch} inches"
    },
    {
      "type": "battery",
      "key": "battery",
      "format": "{capacity} {status} - {cycle-count} cycles",
      "percent": {
        "type": 1
      }
    },
    {
      "type": "disk",
      "key": "disk",
      "format": "{size-total}"
    },
    {
      "type": "board",
      "key": "board",
      "format": "{vendor} {name}"
    },
    {
      "type": "colors",
      "symbol": "diamond"
    }
  ]
}
